\\ irq.6502 - the vertical rupture (exhale's): System VIA T1 at the panel's top, the playfield's top and its
\\ end, two CRTC cycles a frame; the last goes on to the keys (frame.6502). In main RAM.

\\ Shared with the main loop: show sets reqshow to the playfield it's drawn, and the panel's top takes it. The
\\ IRQ flips back to the old one once that's free: at the playfield's end if the request was waiting then (the
\\ old one's last line gone; reqshow's bit 7 set), else when the panel's top takes it. R6 = 16 and R7 = 23
\\ serve both cycles (the panel's 8 rows reach neither), so only R4 and R12 change; each handler leaves &FE00
\\ on the register the next writes first.

ZA_AUTO1 reqshow                        ; in: 0, or the playfield to show next, HI(addr DIV 8); bit 7 once
                                        ; back's flipped
ZA_AUTO1 irqframes                      ; out: frames, counted at the playfield's end

\\ T1's periods: the panel's top to the playfield's, its top to its end, its end to the next panel's top

PanelPeriod = PanelRows * 8 * 64 - 2
ShownPeriod = PlayRows * 8 * 64 - 2
BorderPeriod = (PlayCycleRows - PlayRows) * 8 * 64 - 2
ASSERT LO(PanelPeriod) == &FE AND LO(ShownPeriod) == &FE AND LO(BorderPeriod) == &FE, "T1's reloads: low byte &FE"

\\ The IRQ1V handler. T1 is its only source.
\\
\\ Inputs:
\\     reqshow: a playfield to show, if one is waiting
\\     back: the playfield drawn
\\
\\ Outputs:
\\     reqshow: bit 7 set at the playfield's end if one's waiting; 0 once the panel's top has taken it
\\     back: the other, once the old one's free
\\     irqframes: one more at each playfield's end
\\     A, X, Y: preserved

.irq
{
    ZA_INTERRUPT
    BIT &FE4D                           ; system VIA: IFR (T1 in V)
    BVS irqplay                         ; self-modified: the next of the three
    ZA_CANJUMP irqpanel, irqplay, irqend
.irqbranch
    LDA &FC
    RTI

\\ the panel's top: its cycle 8 rows; the playfield shown in the cycle after

.irqpanel
    LDA #PanelRows-1:STA &FE01          ; CRTC: R4 (irqplay left it selected), the rows less one
    LDA #12:STA &FE00                   ; CRTC: R12 selected, for this and irqplay
    LDA reqshow:BEQ showhi              ; a new playfield
    BMI flipped
    LDA back:EOR #&20:STA back          ; (asked for since the playfield's end: the old one's free now)
    LDA reqshow
.flipped
    AND #&7F:STA showhi+1
    LDA #0:STA reqshow
.showhi
    LDA #HI(PlayAddrA DIV 8):STA &FE01  ; self-modified: the playfield shown (R13 is always 0)
    LDA #(irqplay-irqbranch):STA irqbranch-1
    LDA #HI(ShownPeriod):STA &FE47      ; system VIA: T1L-H, from the playfield's top to its end
    LDA &FC
    RTI

\\ the playfield's top: the panel's address for the cycle after; this cycle 31 rows

.irqplay
    LDA #HI(PanelAddr DIV 8):STA &FE01  ; CRTC: R12 (irqpanel left it selected)
    LDA #4:STA &FE00                    ; CRTC: R4 selected, for this and irqpanel
    LDA #PlayCycleRows-1:STA &FE01
    LDA #(irqend-irqbranch):STA irqbranch-1
    LDA #HI(BorderPeriod):STA &FE47     ; system VIA: T1L-H, from the playfield's end to the panel's top
    LDA &FC
    RTI

\\ the playfield's end: its last line gone; then the keys

.irqend
    LDA reqshow:BEQ @+:BMI @+           ; a new playfield waiting: the old one's last line gone
    ORA #&80:STA reqshow
    LDA back:EOR #&20:STA back          ; (the old one free to draw into)
.@
    INC irqframes
    LDA #(irqpanel-irqbranch):STA irqbranch-1
    LDA #HI(PanelPeriod):STA &FE47      ; system VIA: T1L-H, from the panel's top to the playfield's
.fallsinto                              ; then on into irq_frame (frame.6502)
}

ASSERT irq.irqend - irq.irqbranch < 128, "the rupture's handlers out of the branch's reach"
