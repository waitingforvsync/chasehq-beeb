\\ sprites.6502 - the sprites (tools/gensprites.py) and the plotter that reads them, in the data's bank: main
\\ RAM's plot_sprite and plot_objects page the bank in to call it (D9), the latter for objects.6502.

\\ A sprite is a column of bytes at a time, each column's lines top first; a tiled sprite's columns carry their
\\ first 7 lines again after their last, so 8 lines on from any of its rows wrap (SprStep: a column's bytes less
\\ 8). A byte below &40 is wholly opaque, the screen's own; &FF is wholly transparent; &80 + c has the left
\\ pixel transparent over the right in logical c, &88 + c the other way round (D8). The screen never gets bit 3
\\ of a pixel: logical 8-15 are the sirens' colours (tools/gendata.py).

SECTION DataVars
.MaskTab                                ; a masked byte (&80-&8F, read at MaskTab-&80) -> the screen's
    SKIP 16                             ; bits to keep: its transparent pixel's (made by make_tables)
.OrTab                                  ; and its opaque pixel's bits
    SKIP 16
ENDSECTION
ASSERT LO(MaskTab) >= &80 AND HI(MaskTab) == HI(OrTab + 15), "MaskTab-&80,X and OrTab-&80,X read in a page"

\\ Plot a sprite whole, all its rows from its bottom: sprite_draw with no rows skipped.
\\
\\ Inputs:
\\     A: the sprite
\\     sprite_draw.col: its first byte column, signed
\\     sprite_draw.bottom: its bottom line, 0-127, all of it on the screen
\\     back: the playfield
\\
\\ Outputs:
\\     A, X, Y: corrupted

.sprite_plot
{
    TAX
    LDA SprH,X:STA sprite_draw.lines
    LDA #0:STA sprite_draw.skip
    TXA                                 ; (on into sprite_draw)
}

\\ Plot a sprite, clipped: columns off either side left out, rows hidden under a crest skipped from its
\\ bottom; a tiled sprite (h + 7 bytes a column) repeats its rows up from the bottom for as many as asked. It
\\ goes a band at a time, bottom up: a character row's lines, every column, Y 8 a column on from the band's
\\ first step in both the sprite's pointer and the screen's.
\\
\\ Inputs:
\\     A: the sprite
\\     col: its first byte column, signed
\\     bottom: its bottom row's line, 0-127
\\     skip: its rows hidden below that, from its bottom
\\     lines: the rows to draw, 1-128, no higher than the playfield's top (the caller cuts them), and no
\\          more than are left above skip unless it's tiled
\\     back: the playfield
\\
\\ Outputs:
\\     SkyTop: no lower than its top line
\\     A, X, Y: corrupted

.sprite_draw
{
    ZA_AUTO1 col, bottom, skip, lines   ; in: where, and which rows
    ZA_AUTO2 src, scr                   ; local: a band's pointers, its first column's lowest line less 7
    ZA_AUTO2 under                      ; local: the first column's bytes, less 8
    ZA_AUTO2 corner                     ; local: the band's character row at the first column
    ZA_AUTO1 h                          ; local: the sprite's rows
    ZA_AUTO1 low, y1                    ; local: the band's lowest row (its index, top first) and line
    ZA_AUTO1 left                       ; local: the rows left to draw, less 1
    ZA_AUTO1 d                          ; local: the band's lines less 1
    ZA_AUTO1 t                          ; local: columns cut, the first column, then the band's top row

    TAX
    LDA SprH,X:STA h
    LDA SprLo,X:STA under               ; (less 8)
    LDA SprHi,X:STA under+1

    \\ the columns on the screen: Y of them from screen column A

    LDA col:BMI cut
    CMP #64:BCS gone                    ; (right of the screen)
    EOR #&FF:SEC:ADC #64                ; the columns to the screen's right edge
    CMP SprW,X:BCC @+
    LDA SprW,X
.@
    TAY
    LDA col
    BPL placed                          ; always
.gone
    RTS
.cut
    CLC:ADC SprW,X                      ; the columns left of it cut
    BEQ gone:BMI gone
    TAY
    LDA col:STA t
.cutting
    LDA SprStep,X:CLC:ADC #8            ; a column's bytes (C set if the step's negative)
    CLC:ADC under:STA under
    BCC @+
    INC under+1
.@
    INC t:BNE cutting
    LDA #0                              ; (the first column on the screen: 0)
.placed
    STA t
    TYA:ASL A:ASL A:ASL A:STA colend+1  ; Y at the band's end: 8 a column
    CPY #2:BCC narrow                   ; (one column: no step to the next)
    LDA SprStep,X:STA dl+1              ; a column's bytes less Y's 8
    CMP #&80                            ; (C: fewer than 8)
    LDA #&90:LDY #&E6                   ; BCC, INC zp: 8 or more
    BCC @+
    LDA #&B0:LDY #&C6                   ; BCS, DEC zp: fewer (no carry is a borrow)
.@
    STA carry:STY carried
.narrow
    LDA bottom:LSR A:LSR A:AND #&FE     ; the bottom row's first page, less the playfield's: 2 a row
    ORA back:STA corner+1
    LDA t:ASL A:ASL A:ASL A             ; the column's offset in its half-row (C: the second half)
    STA corner
    BCC @+
    INC corner+1
.@

    \\ the rows: the bottom band from bottom's line (its pointer at the row less 7 - y1: the bands run to
    \\ step 7); the bottom row's index

    LDA bottom:AND #7:STA y1
    ORA #&F8                            ; y1 - 8
    SEC:ADC corner:STA scr
    LDA corner+1:ADC #&FF:STA scr+1     ; (the borrow)
    LDX lines:DEX:STX left
    LDA bottom:SBC left                 ; (C set: corner+1 is &40 or more) its top line, 0-127
    CMP SkyTop:BCS @+                   ; (the sky above it still clean)
    STA SkyTop
.@
    LDA skip                            ; the bottom row's index, top first: h - 1 - skip MOD h
.mod
    CMP h:BCC @+
    SBC h                               ; (C set)
    BCS mod                             ; always
.@
    EOR #&FF:ADC h:STA low              ; (C clear)

    \\ a band: its lines from y1 up to its character row's top, or as many as are left; its first step 7 - d;
    \\ the sprite's pointer so step 7 reads the lowest row, its top row's index wrapped into the sprite (tiled)

.band
    LDA left:CMP y1:BCC @+              ; (the last band)
    LDA y1
.@
    STA d
    EOR #7:TAY                          ; Y: the first step
    STY realign+1
    LDA StepLo,Y:STA entry+1
    LDA low:SEC:SBC d
    BCS @+
.wrap
    ADC h:BCC wrap
.@
    STA t                               ; (C set)
    ADC d                               ; + d + 1
    ADC under:STA src                   ; (C clear)
    LDA under+1:ADC #0:STA src+1
    LDA t:SBC #0                        ; (C clear) the next band's lowest row: the one above
    BCS @+
    ADC h                               ; (wrapped)
.@
    STA low
    JMP entry

    \\ the band's columns, each from its first step to step 7: a byte below &40 stored, &FF skipped, the
    \\ rest masked; the sprite's pointer stepped by a column's bytes less Y's 8

    INPAGE coreend - core
.core
FOR k = 0..3
    ASSERT P% == core + 17 * k
    CMP #&FF:BEQ steps + 7 * k + 6      ; (wholly transparent)
    TAX
    LDA (scr),Y
    AND MaskTab-&80,X
    ORA OrTab-&80,X
    STA (scr),Y
    BCC steps + 7 * k + 6               ; always (C clear: the compare of a byte under &FF)
NEXT
.banddone
    LDA left:CLC:SBC d:BPL above        ; less the band's lines
    RTS
.above
    STA left
    LDA #7:STA y1
    DEC corner+1:DEC corner+1           ; the character row above, whole
    LDA corner:STA scr
    LDA corner+1:STA scr+1
    JMP band
.entry
    JMP steps                           ; self-modified: the band's first step
    ZA_CANJUMP steps + 7 * (0..7)
.steps
FOR k = 0..7
    ASSERT P% == steps + 7 * k
    LDA (src),Y
    IF k < 4
        BMI core + 17 * k
    ELSE
        BMI specials + 17 * (k - 4)
    ENDIF
    STA (scr),Y
    INY
NEXT
.colend
    CPY #0:BEQ banddone                 ; self-modified: 8 a column, the band's last done
    TYA
.realign
    ADC #0                              ; self-modified: the band's first step (C clear: Y below that)
    TAY
    LDA src
.dl
    ADC #0                              ; self-modified: a column's bytes less 8 (C clear)
    STA src
.carry
    BCC entry                           ; self-modified: BCC, or BCS for fewer than 8
.carried
    INC src+1                           ; self-modified: INC, or DEC
    BNE entry                           ; always (the bank's pages)
.specials
FOR k = 4..7
    ASSERT P% == specials + 17 * (k - 4)
    CMP #&FF:BEQ steps + 7 * k + 6      ; (wholly transparent)
    TAX
    LDA (scr),Y
    AND MaskTab-&80,X
    ORA OrTab-&80,X
    STA (scr),Y
    BCC steps + 7 * k + 6               ; always (C clear: the compare of a byte under &FF)
NEXT
.coreend
    ASSERT HI(core) == HI(coreend - 1), "the plotter's core in a page"
}

.StepLo                                 ; the plotter's steps
    EQUB LO(sprite_draw.steps + 7 * (0..7))
