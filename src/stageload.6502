\\ stageload.6502 - a stage's own data put in place at its start (decisions D17, D20, D21): its parts (the
\\ helicopter's, if it has one, kept once for both stages that do; the road's in the code's bank; the sprites'
\\ tables and their parts, in two as the slot is more than a playfield, in the data's; the text's in the
\\ store's), each kept packed in the stages' bank or the store's (stages.6502, store.6502) and filled in as
\\ pieces (roadpieces.6502 and the rest), the text first and the helicopter last.

\\ Each stage's packs: the helicopter's (0 none), the road's, the sprites' tables and parts, the text's; and the
\\ zero page byte holding the bank that keeps each (bankstages, bankstore, or for one bankcode)

StagePacks = {0, Stage1RoadPack, Stage1Sprites.DataPack, Stage1Sprites.PartsPack, Stage1TextPack,
              HeliPack, Stage2RoadPack, Stage2Sprites.DataPack, Stage2Sprites.PartsPack, Stage2TextPack,
              0, Stage3RoadPack, Stage3Sprites.DataPack, Stage3Sprites.PartsPack, Stage3TextPack,
              HeliPack, Stage4RoadPack, Stage4Sprites.DataPack, Stage4Sprites.PartsPack, Stage4TextPack,
              0, Stage5RoadPack, Stage5Sprites.DataPack, Stage5Sprites.PartsPack, Stage5TextPack}
StageParts = 5
.StagePackLo
    EQUB LO(StagePacks)
.StagePackHi
    EQUB HI(StagePacks)
.StagePackBank
    EQUB 0, bankstages, bankstages, bankstages, bankstages
    EQUB bankstore, bankstages, bankstages, bankstages, bankstages
    EQUB 0, bankstages, bankstages, bankstages, bankstore
    EQUB bankstore, bankstages, bankstore, bankstore, bankstages
    EQUB 0, bankcode, bankstore, bankstore, bankstore
    ASSERT P% - StagePackBank == LEN(StagePacks), "a bank for each pack"

\\ The stage intro (intro.6502, the overlay: decisions D26): unpacked from the stages' bank over RoadWindow and the
\\ edge tables and run; then the edge tables cleared (road_start clears RoadWindow), so the entries above the
\\ road are 0 again (D25).
\\
\\ Inputs:
\\     as the intro's
\\
\\ Outputs:
\\     as the intro's; RoadWindow overwritten, the edge tables 0
\\     A, X, Y: corrupted

.intro_run
{
    LDA #LO(IntroPack):STA unzx.src
    LDA #HI(IntroPack):STA unzx.src+1
    LDA #LO(RoadWindow):STA unzx.dst
    LDA #HI(RoadWindow):STA unzx.dst+1
    LDA bankstages:STA &FE30            ; ROMSEL: the stages'
    JSR unzx.unpack
    LDA bankcode:STA &FE30              ; ROMSEL: the code's back
    JSR intro
    LDA #0:TAX
.clear
    STA EdgeRLo,X:STA EdgeLLo,X:STA EdgeR2Lo,X  ; (each page a table's low and high bytes)
    INX:BNE clear
    RTS
}

\\ Each part's bank (its zero page byte) and pieces

PartPieces = {HeliPieces, RoadPieces, SpriteTablePieces, SpritePartPieces, TextPieces}
.PartBank
    EQUB bankdata, bankcode, bankdata, bankdata, bankstore
.PartPiecesLo
    EQUB LO(PartPieces)
.PartPiecesHi
    EQUB HI(PartPieces)

\\ Put a stage's own data in place: for each part, its pack unpacked into the hidden playfield from the bank
\\ that keeps it, then its pieces copied up into the part's bank, one after another.
\\
\\ Inputs:
\\     Stage: 1-5
\\     back, reqshow
\\
\\ Outputs:
\\     the stage's parts in their banks; the hidden playfield overwritten, SkyTop and SkyOther 0
\\     A, X, Y: corrupted

.stage_load
{
    ZA_AUTO1 part                       ; local: the part, 4 down to 0
    ZA_AUTO2 piece                      ; local: its next piece's entry
    ZA_AUTO2 from, to                   ; local: the copy's source (on through the playfield) and destination
    ZA_AUTO1 left                       ; local: a piece's bytes past its whole pages

    JSR wait_back                       ; (the playfield last drawn shown: back the hidden one)
    LDA #0:STA SkyTop:STA SkyOther      ; (neither playfield's sky known any more)
    LDA #StageParts-1:STA part
.nextpart
    LDA Stage:ASL A:ASL A:ADC Stage     ; (C clear) 5 x the stage
    ADC part:TAX                        ; + the part: its pack's index + 5
    LDA StagePackHi-StageParts,X:BEQ parted ; (none)
    STA unzx.src+1
    LDA StagePackLo-StageParts,X:STA unzx.src
    LDY StagePackBank-StageParts,X
    LDA &0000,Y:STA &FE30               ; ROMSEL: the bank that keeps it
    LDA #0:STA unzx.dst:STA from
    LDA back:STA unzx.dst+1:STA from+1
    JSR unzx.unpack
    LDX part
    LDY PartBank,X
    LDA &0000,Y:STA &FE30               ; ROMSEL: the part's bank
    LDA PartPiecesLo,X:STA piece
    LDA PartPiecesHi,X:STA piece+1
    JSR pieces
.parted
    DEC part:BPL nextpart
    LDA bankcode:STA &FE30              ; ROMSEL: the code's back
    RTS

    \\ each piece: its address (0 the end) and bytes, its whole pages then the rest

.pieces
    LDY #0:LDA (piece),Y:STA to
    INY:LDA (piece),Y:BNE @+
    RTS                                 ; (no piece in page 0: the end)
.@
    STA to+1
    INY:LDA (piece),Y:STA left
    INY:LDA (piece),Y:TAX               ; X: its whole pages
    LDA piece:CLC:ADC #4:STA piece
    BCC @+
    INC piece+1
.@
    LDY #0
    TXA:BEQ rest
.pages
    LDA (from),Y:STA (to),Y
    INY:BNE pages
    INC from+1:INC to+1
    DEX:BNE pages
.rest
    LDX left:BEQ pieces
.bytes
    LDA (from),Y:STA (to),Y
    INY:DEX:BNE bytes
    TYA:CLC:ADC from:STA from           ; (Y: the rest's bytes, so from on past the piece)
    BCC pieces
    INC from+1
    BCS pieces                          ; always
}
