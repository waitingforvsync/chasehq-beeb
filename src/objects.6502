\\ objects.6502 - the roadside objects and the tunnel's state after the road, in main RAM (decisions D19):
\\ run with the data's bank paged in (plotting.6502's plot_objects), for its plotter and its tables.

\\ The tunnel after the road (the CPC's &44E1): a mouth road_draw saw, at its row, an entrance's band dark red
\\ with the sky above it (the tunnel beyond), an exit's black with black above; or in a tunnel with none in
\\ view, a black band at the first row from 4 to 8 where the road widens a row on, else 9 (the far end's
\\ dark), and the engine's tunnel note (the CPC's &1770, read at the next loop's start), left as it was while
\\ a mouth is in view.
\\
\\ Inputs:
\\     MouthKind, MouthAt, TunnelBeyond; RowXL, RowXR (road_rows)
\\
\\ Outputs:
\\     MouthRow, MouthBand, MouthAbove
\\     enginebase, sndatt: the engine's (its volume from the IRQ's next frame, its note from the next
\\     loop's sound_update; the CPC's both from its next loop)
\\     A, X: corrupted

.tunnel_state
{
    LDA MouthKind:BEQ none
    AND #&10:LSR A:LSR A:LSR A          ; (an entrance's 0, an exit's 2: its flags' bit 4)
    STA MouthBand
    LDA TunnelBeyond:ASL A:ADC #2       ; (C clear: the sky, 4, above an entrance; black, 2, above an exit)
    STA MouthAbove
    LDA MouthAt:STA MouthRow
    RTS
.none
    LDA TunnelBeyond:BNE inside
    STA MouthRow                        ; (no tunnel)
    LDA #EngineBase:STA enginebase
    LDA #EngineAtt:STA sndatt
    RTS
.inside
    LDA #EngineTunnelBase:STA enginebase
    LDA #EngineTunnelAtt:STA sndatt
    LDA #2:STA MouthBand
    LDA #6:STA MouthAbove
    LDX #4
.scan
    LDA RowXLLo+1,X:CMP RowXLLo,X       ; the left edge further left a row on, or the right further right
    LDA RowXLHi+1,X:SBC RowXLHi,X       ; (unsigned, as the CPC's): the band at this row
    BCC row
    LDA RowXRLo,X:CMP RowXRLo+1,X
    LDA RowXRHi,X:SBC RowXRHi+1,X
    BCC row
    INX:CPX #9:BNE scan
.row
    STX MouthRow
    RTS
}

\\ The roadside objects, rows 20 to 1, far to near: each row's right object, then its left (the CPC's
\\ &238C's). An object stands on its row's line, or the crest's in front where that's higher; its parts are
\\ stacked up from there, tiled ones as tall as their share of the row's scale.
\\
\\ Inputs:
\\     RoadWindow, RoadSeg, RoadY, RowXR, RowXL, RowScale
\\     back: the playfield
\\
\\ Outputs:
\\     A, X, Y: corrupted

.draw_objects
{
    ZA_AUTO1 r                          ; local: the row, 20 down to 1
    ZA_AUTO1 yb                         ; local: the lowest line of the rows from 1 out to here
    ZA_AUTO1 cars                       ; local: the row's cars left, a bit each
    ZA_AUTO1 win                        ; local: the row's right object's place in the window (the left's &20 on)

    JSR tunnel_state

    \\ RowYB: the line a row's objects stand on, the higher of its own and those in front (a crest hides
    \\ what's behind it)

    LDA #255:STA yb
    LDX #1
.crest
    LDA RoadY,X:CLC:ADC #32
    CMP yb:BCS @+
    STA yb
.@
    LDA yb:STA RowYB,X
    INX:CPX #22:BNE crest               ; (row 21's for the tunnel's mouth)

    \\ the tunnel's mouth: beyond the rows, now; or bit 0 of its row's RowCars, out of the cars' ASLs after
    \\ theirs (row 0's, for none or once drawn, never read); rows 22 and 23 never (a hidden entrance's). The
    \\ helicopter, flying: bit 1 of row 3's, after its cars and before a mouth (the CPC's hooks at &23C8, &23CB)

    LDY MouthRow
    CPY #21:BCC mark
    BNE marked
    LDA RowYB+21:JSR draw_mouth
    LDY #0
.mark
    LDA #1:STA RowCars,Y                ; (rows 1-20 clear till the slots' bits go in)
.marked
    LDA RoadHints:BEQ @+                ; (the helicopter's state: 0 gone)
    LDA RowCars+3:ORA #2:STA RowCars+3
.@

    \\ RowCars: each row's cars, slot k at bit k + 2 (slot 5 out of an ASL first); each row's left clear for
    \\ the next frame

    LDX #MaxObjects-1
.slots
    LDY ObjRow,X:BEQ @+                 ; (not drawn)
    LDA RowCars,Y:ORA SlotBit,X:STA RowCars,Y
.@
    DEX:BPL slots

    LDA RoadSeg:CLC:ADC #WinObjects+19:STA win      ; (mod 256, the window a ring: a carry into the row
    LDA #20:STA r                                   ; would read the next one, as it once did)
.row
    LDY r:LDA RowCars,Y:BEQ objects     ; the cars on the row first, slot 5 down, then the helicopter, the mouth
    STA cars
    LDA #0:STA RowCars,Y
    LDX #MaxObjects-1
.car
    ASL cars:BCC next
    TXA:BMI special
    STX carslot
    JSR one_car
    LDX carslot
.next
    DEX
    LDA cars:BNE car
    BEQ objects                         ; always
.special
    CPX #&FF:BNE mouth                  ; (bit 0: the mouth)
    JSR air_draw                        ; (bit 1: the helicopter)
    LDX #&FF:BNE next                   ; always
.mouth
    LDY r:LDA RowYB,Y:JSR draw_mouth    ; (over the row's cars and what's beyond, under its objects)
.objects
    LDY win:LDA RoadWindow,Y:BEQ @+     ; the right side's object
    LDX #0:JSR one_object
.@
    LDA win:CLC:ADC #&20:TAY
    LDA RoadWindow,Y:BEQ @+             ; the left side's
    LDX #10:JSR one_object
.@
    DEC win
    DEC r:BNE row
    RTS

    \\ an object: A its id, X 0 right or 10 left, r its row

.one_object
    ZA_AUTO1 side, kind, ya, ycrest, scale, stack, yoff
    ZA_AUTO1 anchor, at                 ; local: the side's edge at the row; a left part's x + 4w
    ZA_AUTO2 parts                      ; local: the part records
    ZA_AUTO1 n, height                  ; local: the part's sprite and rows

    STX side
    CLC:ADC side:TAX
    LDA ObjKind,X:BEQ gone
    STA kind
    BMI gantry                          ; (&80, the gantry)
.object
    TXA:ASL A:STA n                     ; (side * 10 + id) * 10 + size - 1
    ASL A:ASL A:ADC n                   ; (C clear: under 256)
    STA n
    LDX r:CPX #10:BCC @+
    LDX #10
.@
    DEX:TXA:CLC:ADC n:TAY
    LDA ObjPartLo,Y:STA parts
    LDA ObjPartHi,Y:STA parts+1
    LDY r
    LDA RoadY,Y:CLC:ADC #32:STA ya
    LDA RowYB,Y:STA ycrest
    LDA RowScale,Y:STA scale
    LDX side:BNE leftside
    LDA RowXRLo,Y:STA anchor
    LDA RowXRHi,Y:BEQ anchored
.gone
    RTS
.gantry
    JSR object                          ; (its pylon as parts, then its beam)
    JMP gantry_beam
.leftside
    LDA RowXLLo,Y:STA anchor
    LDA RowXLHi,Y:BNE gone
.anchored
    LDA #0:STA stack:STA yoff
    LDA kind:CMP #1:BNE parted
    LDA r:CMP #16:BCS gone              ; raised: rows 1-15 only, scale less a quarter up
    LDA scale:LSR A:LSR A
    EOR #&FF:SEC:ADC scale:STA yoff

    \\ a part: its column (x, 0-127 from gensprites: right, the edge + x; left, the edge + 8 - x - 4w, both
    \\ in quarter-bytes, 9 bits enough: what wraps is off the screen either way), its rows, its place up the
    \\ stack

.parted
    LDY #2:LDA (parts),Y
    CMP #1:BEQ gone                     ; (the end of the list)
    STA kind
    LDY #0:LDA (parts),Y:STA n
    TAX
    LDA SprH,X:STA height
    LDY #1
    LDA side:BNE leftx
    LDA (parts),Y
    CLC:ADC anchor                      ; (C: bit 8)
    BNE @+
    BCC offscreen                       ; (exactly 0: the CPC doesn't draw it)
.@
    ROR A:LSR A:STA sprite_draw.col
    BPL placed                          ; always (0-85)
.offscreen
    LDA #64:STA sprite_draw.col         ; (off the screen: not drawn, though it stacks)
    BNE placed                          ; always
.leftx
    LDA anchor:CMP #256 - 8:BCS offscreen   ; (the edge + 8 carrying: the CPC doesn't draw it)
    LDA SprW,X:ASL A:ASL A              ; x + 4w (C clear: w 16 or less)
    ADC (parts),Y:STA at
    LDA anchor:SEC:SBC at               ; the edge less that, 9 bits signed (C its sign, inverted)
    ROR A:EOR #&80                      ; / 2
    CMP #&80:ROR A                      ; / 4
    CLC:ADC #2:STA sprite_draw.col      ; (+ 8)
.placed

    \\ its rows: fixed, or tiled to k * scale less the stack (at least 1)

    LDA kind:CMP #3:BCC rowsset
    SBC #3:TAX                          ; (C set)
    JSR tile_height
    SEC:SBC stack
    BEQ @+
    BCS tiledset
.@
    LDA #1
.tiledset
    STA height

    \\ where it stands: on the row's line less the stack (and a raised object's lift); behind a crest its
    \\ hidden rows are skipped and it stands on the crest

.rowsset
    LDA stack:CLC:ADC yoff              ; (the part's lift)
    EOR #&FF:SEC:ADC ya                 ; the row's line less that
    LDX #0
    CMP ycrest:BEQ @+:BCC @+            ; (the crest no higher)
    SBC ycrest:TAX                      ; (C set) the rows below the crest
    LDA ycrest
.@
    STA sprite_draw.bottom
    STX sprite_draw.skip
    LDA height:SEC:SBC sprite_draw.skip
    BEQ stacked:BCC stacked
    STA sprite_draw.lines
    LDA sprite_draw.bottom:BMI stacked  ; (above the playfield)
    CMP sprite_draw.lines:BCS @+
    ADC #1:STA sprite_draw.lines        ; (C clear) the rows to the playfield's top
.@
    LDA n:JSR sprite_draw

.stacked
    LDA stack:CLC:ADC height:STA stack
    LDA parts:CLC:ADC #3:STA parts
    BCC @+
    INC parts+1
.@
    JMP parted

}

\\ The gantry's beam (the CPC's &2474), after its pylon, drawn or not: across columns (XL + 8 - x) / 4 (0 with
\\ the left edge off the left) to (XR + x) / 4 (64 off the right), x its pylon's at the size; its bottom line
\\ ya - 1.5 scale, mod 256 (the CPC's yb - (1.5 scale - (ya - yb))), none above the playfield; its size's
\\ lines, as far as the playfield's top, each its colour by the line's parity from the bottom up. Its fills
\\ into BeamBuf from the data's bank; then, with the code's paged in, each line by the row runner from its
\\ first column's store to an RTS at its end's, a row's pages by runner_row from its first column's patch to an
\\ RTS at its end's (from 32's, the ORA #1, for a beam from 33 on).
\\
\\ Inputs:
\\     draw_objects.r: its row
\\     back: the playfield; the data's bank paged in
\\
\\ Outputs:
\\     the playfield; SkyTop lowered to the beam's top
\\     A, X, Y: corrupted

.gantry_beam
{
    ZA_AUTO1 left                       ; local: its first column, 0-61
    ZA_AUTO1 right                      ; local: the column past its last, 1-64; then 3 times it
    ZA_AUTO1 bottom                     ; local: its bottom line, 0-127
    ZA_AUTO1 lines                      ; local: its lines less 1
    ZA_AUTO1 page                       ; local: the row's first page
    ZA_AUTO1 stop                       ; local: runner_row's RTS's place in it
    ZA_AUTO1 saved                      ; local: the byte the RTS is over

    LDX draw_objects.r:CPX #10:BCC @+
    LDX #10                             ; X: its size
.@
    LDY draw_objects.r
    LDA RowXLHi,Y:BMI zero              ; (the left edge off the left: from column 0)
    BNE beamless                        ; (off the right: none)
    LDA RowXLLo,Y:CLC:ADC #16           ; (its carry dropped, as the CPC's)
    SEC:SBC GantryX-1,X:BCC zero
    SBC #8:BCC zero                     ; (C set)
    LSR A:LSR A
    BPL lefted                          ; always (0-61)
.zero
    LDA #0
.lefted
    STA left
    LDA RowXRHi,Y:BMI beamless          ; (the right edge off the left: none)
    BNE wide                            ; (off the right: to column 64)
    LDA RowXRLo,Y:CLC:ADC GantryX-1,X
    BCS wide                            ; (0 only with a carry: x 1 at least, gensprites')
    CMP #&F8:BCS wide
    LSR A:LSR A
    CMP left:BEQ beamless:BCS righted   ; (none if it ends where it starts: the CPC's run would go astray)
.beamless
    RTS
.wide
    LDA #64                             ; (left 61 at most)
.righted
    STA right
    LDA RowScale,Y:LSR A:CLC:ADC RowScale,Y ; 1.5 scale (93 at most: C clear)
    EOR #&FF:ADC #33                    ; 32 less it
    CLC:ADC RoadY,Y:BMI beamless        ; ya less it (above the playfield: none)
    STA bottom
    LSR A                               ; (C: its parity)
    LDA GantryAt-1,X:BCC @+
    ADC #GantryOdd-GantryEven-1         ; (C set: the odd bottom's)
.@
    TAY
    LDA bottom
    CMP GantryHeight-1,X:BCC lined      ; (as far as the playfield's top: the line its lines less 1)
    LDA GantryHeight-1,X                ; (its lines less 1 no more than the line: all of them)
.lined
    STA lines
    TAX                                 ; BeamBuf from the top: the bottom line's fill at its lines less 1
    EOR #&FF:SEC:ADC bottom             ; its top line
    CMP SkyTop:BCS copy
    STA SkyTop
.copy
    LDA GantryEven,Y:STA BeamBuf,X
    INY:DEX:BPL copy

    \\ the code's bank: the runner's RTS at column R; runner_row's at R's patch (+ 2 from 33, past its
    \\ ORA #1; its own at 64)

    LDX bankcode:STX &FE30              ; ROMSEL: the code's bank
    LDA right:ASL A:ADC right           ; (C clear: 192 at most)
    STA right:TAY
    LDA #&60:STA Runner,Y               ; (RTS: the run's end)
    TYA:CMP #3 * 33:BCC @+
    ADC #1                              ; (C set: + 2)
.@
    ADC #6:STA stop:TAY                 ; (C clear)
    LDA runner_row,Y:STA saved
    LDA #&60:STA runner_row,Y           ; (RTS: the patches' end)

    \\ both entered at column L: runner_row at its patch (32's, the ORA #1, from 33, with the page as at 32)

    ASSERT HI(runner_row + 6) == HI(runner_row + 6 + 3 * 32), "runner_row's first half's patches in a page"
    LDA left:ASL A:ADC left             ; (C clear)
    TAX
    ADC #LO(Runner):STA go+1            ; (C clear)
    TXA:CMP #3 * 32:BCC @+
    LDA #3 * 32 - 1                     ; (C set)
.@
    ADC #LO(runner_row + 6):STA rrgo+1

    \\ each line from the bottom up: Y its index in BeamBuf, X its line in its row

    LDA bottom:AND #7:TAX
    LDY lines
    LDA bottom:LSR A:LSR A:AND #&FE:ORA back    ; the bottom row's first page
    SEC                                 ; (kept: the rows' pages less 2)
.row
    STA page
.rrgo
    JSR runner_row + 6                  ; self-modified: column L's patch
    ZA_CANCALL runner_row
.lineloop
    LDA BeamBuf,Y
.go
    JSR Runner                          ; self-modified: column L's store
    ZA_CANCALL Runner
    DEY:BMI done
    DEX:BPL lineloop
    SAME_PAGE lineloop
    LDX #7                              ; (a new row)
    LDA page:SBC #2                     ; (C set: the row above's first page)
    BCS row                             ; always
.done
    LDY right:LDA #&9D:STA Runner,Y     ; (STA abs,X back)
    LDY stop:LDA saved:STA runner_row,Y
    LDX bankdata:STX &FE30              ; ROMSEL: the data's back
    RTS
}

\\ A car, at its projected place, clipped.
\\
\\ Inputs:
\\     X: its slot
\\
\\ Outputs:
\\     A, X, Y: corrupted

.one_car
{
    LDA ObjCol,X:STA sprite_draw.col
    LDA ObjBottom,X:STA sprite_draw.bottom
    LDA #0:STA sprite_draw.skip
    LDY ObjSprite,X:LDA CarSprite,Y
    TAY
    LDA SprH,Y
    CMP sprite_draw.bottom:BCC @+       ; no higher than the playfield's top
    LDA sprite_draw.bottom:ADC #0       ; (C set: + 1)
.@
    STA sprite_draw.lines
    TYA:JMP sprite_draw
}

ZA_AUTO1 carslot                        ; local to draw_objects: the slot being drawn

\\ A tiled part's height from the row's scale: k * scale for its kind (3-10: 1.5, 0.5, 1.125, 0.375, 0.75,
\\ 0.25, 1, 2).
\\
\\ Inputs:
\\     X: the kind less 3
\\     draw_objects.scale
\\
\\ Outputs:
\\     A: the height
\\     X, Y: corrupted

.tile_height
{
    ZA_AUTO1 half, eighth               ; local: scale / 2, scale / 8

    LDA draw_objects.scale:LSR A:STA half
    LSR A:LSR A:STA eighth
    LDA TileLo,X:STA go+1
    LDA TileHi,X:STA go+2
.go
    JMP &FFFF                           ; self-modified: the kind's
    ZA_CANJUMP k15, k05, k1125, k0375, k075, k025, k1, k2
.k15
    LDA half:CLC:ADC draw_objects.scale:RTS
.k05
    LDA half:RTS
.k1125
    LDA eighth:CLC:ADC draw_objects.scale:RTS
.k0375
    LDA half:SEC:SBC eighth:RTS
.k075
    LDA half:LSR A:CLC:ADC half:RTS
.k025
    LDA half:LSR A:RTS
.k1
    LDA draw_objects.scale:RTS
.k2
    LDA draw_objects.scale:ASL A:RTS
}

.TileLo
    EQUB LO(tile_height.k15), LO(tile_height.k05), LO(tile_height.k1125), LO(tile_height.k0375)
    EQUB LO(tile_height.k075), LO(tile_height.k025), LO(tile_height.k1), LO(tile_height.k2)
.TileHi
    EQUB HI(tile_height.k15), HI(tile_height.k05), HI(tile_height.k1125), HI(tile_height.k0375)
    EQUB HI(tile_height.k075), HI(tile_height.k025), HI(tile_height.k1), HI(tile_height.k2)

SECTION GameVars
.BeamBuf                                ; gantry_beam's: each line's fill, from the top
    SKIP 32
.RowYB                                  ; each row's line for its objects (crests in front), rows 1-21
    SKIP 22
.RowCars                                ; each row's cars, slot k at bit k + 2 (clear but in draw_objects:
    SKIP 21                             ; make_tables clears it)
ENDSECTION

.SlotBit                                ; slot k's bit in RowCars
    EQUB 1 << ((0..MaxObjects-1) + 2)
